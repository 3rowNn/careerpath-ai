# ค่าสำหรับ docker compose (ทั้งระบบ) — คัดลอกเป็น .env ที่ root แล้วแก้ค่า · ห้าม commit .env
#   cp .env.example .env

# จำเป็น: กุญแจเซ็น JWT — สุ่มใหม่ด้วย:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# รหัสฐานข้อมูล — ถ้าเว้นไว้ใช้ careerpath_dev (พอสำหรับรันในเครื่อง/นำเสนอ)
# ใช้บนเซิร์ฟเวอร์จริงให้ตั้งใหม่ "ก่อน" รันครั้งแรก (รหัสถูกตั้งตอนสร้าง volume ครั้งเดียว)
POSTGRES_PASSWORD=

# AI Advisor (ไม่บังคับ) — key ฟรีจาก Google AI Studio · เว้นไว้ = ใช้คำตอบสรุปจาก ML แทน
GEMINI_API_KEY=

# พอร์ตของเว็บบนเครื่องนี้ → http://localhost:8080
WEB_PORT=8080
