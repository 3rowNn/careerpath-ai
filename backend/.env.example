# คัดลอกเป็น backend/.env (ห้าม commit .env)
# ไม่ตั้ง DATABASE_URL = ปิดระบบบัญชี (endpoint /api/auth/* ตอบ 503) ส่วนอื่นใช้งานได้ปกติ
DATABASE_URL=postgresql+psycopg://careerpath:careerpath_dev@localhost:5432/careerpath
# สุ่มใหม่ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=14

# AI Advisor (ไม่บังคับ) — ไม่ตั้ง = /api/advisor/chat ตอบ 503 และหน้าเว็บใช้คำตอบตัวอย่าง
# ขอ key ฟรีที่ Google AI Studio · ห้าม commit key จริง
GEMINI_API_KEY=
# ADVISOR_MODEL=gemini-3.5-flash
