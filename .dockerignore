# context ของ backend image = root ของ repo — คัดลอกเฉพาะที่ Dockerfile ระบุ แต่กันไฟล์ใหญ่/ลับไว้ก่อน
# ค่าลับ — ห้ามเข้า image
**/.env
**/.env.*
!**/.env.example
**/*.local

# สภาพแวดล้อม/แคช
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ipynb_checkpoints
**/.DS_Store
.git
.vscode

